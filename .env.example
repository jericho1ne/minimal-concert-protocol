# Copy this file to .env and fill in the values. Never commit .env.

# Required: read-only Postgres role. Supabase transaction pooler URLs are supported.
# Example: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Local-test escape hatch only. Skips server certificate verification when true.
DATABASE_SSL_NO_VERIFY=false

# Required for venue-neighborhood/genre enrichment when DB fields are unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for live email delivery. EMAIL_FROM must use a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_BACKENDS=resend

# Optional local cache and server settings.
CACHE_TTL_HOURS=12
CACHE_DB_PATH=.data/letsgetdown.sqlite
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Set for HTTP bearer-token protection; leave empty for localhost-only development.
MCP_AUTH_TOKEN=

# Later SMS/Klaviyo story only; not used by the v1 email tools.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
